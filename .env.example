# 🚀 LABONO Auth — Configuração de Ambiente
# =============================================================================
# Instruções:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores abaixo (substitua os placeholders)
#   3. NUNCA commite o arquivo .env ou .env.local (já estão no .gitignore)
# =============================================================================

# ─── Rails ─────────────────────────────────────────────────────────────────────
RAILS_ENV=development
PORT=3000
SECRET_KEY_BASE=your_random_secret_key_base_here_change_me

# ─── JWT (JSON Web Token) ─────────────────────────────────────────────────────
# Gere com: ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
JWT_SECRET=your_jwt_secret_here_change_me

# ─── Banco de Dados (PostgreSQL) ──────────────────────────────────────────────
# Para Docker Compose, use: DATABASE_HOST=db
# Para local, use: DATABASE_HOST=127.0.0.1
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=auth_dev_db
DATABASE_USER=auth_dev
DATABASE_PASSWORD=dev_secure_pass_123

# ─── Redis (Cache + Rate Limit + JWT Blacklist) ──────────────────────────────
# Para Docker Compose, use: redis://redis:6379/0
# Para local, use: redis://127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=seu_admin_email@dominio.com
ADMIN_PASSWORD=
# Opcional: e-mail de backup para dual-code reset (se vazio, ambos códigos
# serão enviados apenas para ADMIN_EMAIL)
ADMIN_BACKUP_EMAIL=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Configure com as credenciais do seu provedor de email.
# Exemplo Gmail (App Password): https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app_aqui
SMTP_AUTH=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# ─── Domínio ───────────────────────────────────────────────────────────────────
DOMAIN_HOST=localhost
DOMAIN_PORT=3000
EMAIL_FROM=seuemail@gmail.com
